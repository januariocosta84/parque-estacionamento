# Production settings for docker-compose.prod.yml (docs/DEPLOY.md).
# Copy to .env.production on the server, fill in every value, and keep it private.
# Use long random passwords, e.g.: openssl rand -base64 30

# Public names that point at the server (Caddy gets HTTPS certificates for both)
API_DOMAIN=
CONSOLE_DOMAIN=

# PostgreSQL table owner (migrations only)
POSTGRES_USER=estacionamento_owner
POSTGRES_PASSWORD=
POSTGRES_DB=estacionamento

# Restricted role the API connects as (lower-case letters, digits, _)
APP_DB_USER=estacionamento_app
APP_DB_PASSWORD=

# First admin account (created once; change the password after first sign-in)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=

# SMS for console sign-in codes — provider not chosen yet. With the stub the codes go to the
# API log; only set ALLOW_SMS_STUB=true knowingly (docs/SECURITY.md).
SMS_PROVIDER=stub
ALLOW_SMS_STUB=false

# Days of daily backups kept on the server (copy them off-site as well)
BACKUP_KEEP_DAYS=
