{
  "expo": {
    "name": "Estacionamento Dili",
    "slug": "estacionamento-dili",
    "scheme": "estacionamento",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["android", "ios", "web"],
    "android": {
      "package": "tl.gov.amd.estacionamento"
    },
    "ios": {
      "bundleIdentifier": "tl.gov.amd.estacionamento",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
