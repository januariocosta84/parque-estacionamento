# Copy to .env (root, used by docker compose) and apps/api/.env (used by the API).
# Development values only — real deployments use their own secrets.

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=estacionamento
POSTGRES_PASSWORD=change-me
POSTGRES_DB=estacionamento
POSTGRES_PORT=5432

# API (apps/api)
DATABASE_URL=postgresql://estacionamento:change-me@localhost:5432/estacionamento
# Integration tests. The name MUST end in _test: the test setup wipes this database.
DATABASE_URL_TEST=postgresql://estacionamento:change-me@localhost:5432/estacionamento_test
API_HOST=0.0.0.0
API_PORT=3001
# Browser origins allowed to call the API (console; Expo web preview in development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Set to true behind a reverse proxy (production), so rate limits see real client IPs.
TRUST_PROXY=false
# Console sign-in codes (FR-04) are sent by WhatsApp through Fonnte (docs/DECISIONS.md).
#   SMS_PROVIDER=fonnte  needs FONNTE_TOKEN (Fonnte dashboard → device token). Never commit it.
#   SMS_PROVIDER=stub    writes codes to the API log (development); production refuses it
#                        unless ALLOW_SMS_STUB=true is set on purpose.
SMS_PROVIDER=stub
FONNTE_TOKEN=
# Added to 8-digit local numbers (Timor-Leste); numbers with a country code are used as given.
FONNTE_COUNTRY_CODE=670
ALLOW_SMS_STUB=false

# Seed (pnpm --filter @estacionamento/api db:seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=choose-a-long-password
SEED_ADMIN_PHONE=
# Development only: also create agent AMD-001 (Setor A) with this 6-digit PIN. Leave empty in production.
SEED_DEV_AGENT_PIN=

# Console (apps/console)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Agent app (apps/agent) — use your computer's LAN IP when testing on a real phone
EXPO_PUBLIC_API_URL=http://localhost:3001
